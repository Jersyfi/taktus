# The environment of one Taktus instance. Names only: copy this file to .env (ignored by git)
# and fill in the values there. No value is ever committed to this repository (CLAUDE.md §9).
# The composition root reads these through the configuration port; an empty variable counts as
# not configured.

# Where the state lives. Unset: `taktusctl run` uses the in-memory implementation with a file
# snapshot under TAKTUS_STATE_DIR — development only, not durable; `taktusd` refuses to start.
# Set: PostgreSQL, migrated with `make migrate`. The URL may carry a password; the whole of it
# is a secret (CREDENTIALS.md) and is therefore read from a FILE: TAKTUS_DATABASE_URL_FILE
# holds the path, the file holds the URL. The inline variable is accepted for a URL that
# carries no password — the development database of deploy/docker/compose.dev.yml trusts local
# connections: postgresql://taktus@127.0.0.1:5432/taktus. Setting both is refused.
TAKTUS_DATABASE_URL_FILE=
TAKTUS_DATABASE_URL=

# How the control plane reaches an execution unit for `worker` steps (ADR-0002):
#   endpoint   a worker that is already running, at TAKTUS_WORKER (default). Its isolation
#              is whoever started it: the control plane did not start it and enforces nothing
#              on it — not the resource limits, and not frame.allowed_hosts. A process at
#              autonomy level 3 or above needs an isolated unit, and with this kind that is
#              the operator's to provide, not the core's to check (DEC-0022)
#   process    a unit started per job as a child process of this one — no isolation; refused
#              from autonomy level 3 upwards; TAKTUS_EXECUTION_UNIT is its command line
#   container  a unit started per job in a container with limits, credentials in memory only
#              and a network that reaches the allowed hosts and nothing else;
#              TAKTUS_EXECUTION_UNIT is its image
#   cluster    a unit started per job as a Job in the execution namespace of the cluster the
#              control plane runs in, with limits, credentials from a Secret that lives as
#              long as the job, and an egress proxy of its own (deploy/k8s/README.md §7);
#              TAKTUS_EXECUTION_UNIT is its image
TAKTUS_EXECUTION=
TAKTUS_WORKER=
TAKTUS_EXECUTION_UNIT=

# A launched unit: the port it serves the contract on inside its isolation (default 9000), the
# directory its checkpoints outlive a job in (default /var/lib/taktus/unit), its limits (CPU
# cores, default 1.0; memory, default 1024 MB; wall clock per job, default 3600 s), and how
# long it may take to answer health (default 60 s).
TAKTUS_EXECUTION_UNIT_PORT=
TAKTUS_EXECUTION_UNIT_STATE_DIR=
TAKTUS_EXECUTION_CPUS=
TAKTUS_EXECUTION_MEMORY_MB=
TAKTUS_EXECUTION_WALL_SECONDS=
TAKTUS_EXECUTION_START_TIMEOUT_SECONDS=

# The process adapter enforces a unit's memory limit on Linux only. Elsewhere it refuses the job,
# unless this is true: the operator's explicit acceptance of a limit that is not enforced
# (default false; docs/architecture/platform.md §5).
TAKTUS_EXECUTION_MEMORY_UNENFORCED=

# The container adapter: the container engine's socket (default /var/run/docker.sock; Podman
# answers the same API); the network this process shares with each job's egress container
# when the control plane itself runs in a container — unset, the egress container publishes
# the unit's port on 127.0.0.1 of the machine the engine runs on; and the image the egress
# container runs from (default python:3.13-slim; anything with python3 on the path).
TAKTUS_EXECUTION_ENGINE_SOCKET=
TAKTUS_EXECUTION_NETWORK=
TAKTUS_EXECUTION_EGRESS_IMAGE=

# The cluster adapter: the execution namespace (required); whether the cluster enforces network
# policies (default true — false refuses a job whose frame names hosts and every job from
# autonomy level 3 upwards); the account jobs run as (default: the namespace's own, never
# Taktus's); and a volume claim for the unit's state (unset: the state dies with each job). The
# egress proxy runs from TAKTUS_EXECUTION_EGRESS_IMAGE. The adapter reaches the cluster's API
# with the pod's own service account; outside a cluster it does not start.
TAKTUS_EXECUTION_NAMESPACE=
TAKTUS_EXECUTION_EGRESS_ENFORCE=
TAKTUS_EXECUTION_SERVICE_ACCOUNT=
TAKTUS_EXECUTION_STATE_CLAIM=

# A credential an assignment references by name — VCS_TOKEN, CODING_AGENT_API_KEY — is read
# by the execution adapter at the moment a unit is started, from a FILE the variable
# TAKTUS_CREDENTIAL_<NAME>_FILE points at, and injected into the unit: never from the
# environment, never onto a volume or into a log (CREDENTIALS.md). One variable per name.
# TAKTUS_CREDENTIAL_<NAME>_FILE=

# The model `llm` steps ask, over the OpenAI-compatible chat-completions dialect: the base URL
# that serves /chat/completions (a vendor's API, a local model server), the model to ask it for,
# and the purposes it serves — comma separated, `*` (the default) for every purpose a process
# names. Unset: no model, and an llm step fails naming these. The bearer credential, when the
# endpoint needs one, is the parameter MODEL_API_KEY (CREDENTIALS.md), read from a FILE.
TAKTUS_MODEL_ENDPOINT=
TAKTUS_MODEL_NAME=
TAKTUS_MODEL_PURPOSES=
TAKTUS_CREDENTIAL_MODEL_API_KEY_FILE=
# What the endpoint's provider permits a budget to be (contracts/model/v1, Calculability;
# docs/research/2026-09-30-what-providers-allow.md): how it bills — per_token (default),
# per_window (a subscription's time window: a currency budget cannot be enforced) or
# per_hardware_time — whether its output limit is hard (hard, soft — the default — or none),
# and what it enforces itself (hard, alert, none, unknown — information only).
TAKTUS_MODEL_BILLING=
TAKTUS_MODEL_OUTPUT_CAP=
TAKTUS_MODEL_PROVIDER_LIMIT=

# --- Budget (ADR-0005) -----------------------------------------------------------------------
# A price table in the shape of contracts/model/v1/Model.json#/$defs/PriceTable. Without one no
# model is priced, and a run whose budget is in a currency says so when its budget is set.
TAKTUS_PRICE_TABLE=
# The share of every budget held back from the first step on, 0 to 0.9; nothing by default.
TAKTUS_BUDGET_MARGIN=
# What a worker with no calibration history reserves beyond its estimate: 1.0 — twice the
# estimate — by default (DEC-0034). A worker with history uses its calibration instead.
TAKTUS_BUDGET_UNCALIBRATED_MARGIN=

# The first run (tools/first_run.sh, docs/runs/): the FILES that hold the repository token the
# reference connector acts with, and the coding agent's credential — an API key OR a
# subscription token; the one that is set decides the worker's authentication mode. Each is a
# credential parameter and is therefore named TAKTUS_CREDENTIAL_<NAME>_FILE, the one pattern
# for every credential, whoever reads it (DEC-0018). Paths only; the files are created by the
# owner following NEED-0002 and NEED-0001 (docs/decisions/), readable by the owner alone, and
# never committed.
#
# The repository connector acts as Taktus's own app when both app variables are set (ADR-0033,
# the default): the app's identifier, which is not a secret, and the FILE that holds the app's
# private key (NEED-0013). The token file is for a tenant without an app; it is not read when
# the app is set.
TAKTUS_REPOSITORY_APP_ID=
TAKTUS_CREDENTIAL_REPOSITORY_APP_KEY_FILE=
TAKTUS_CREDENTIAL_REPOSITORY_TOKEN_FILE=
TAKTUS_CREDENTIAL_CODING_AGENT_API_KEY_FILE=
TAKTUS_CREDENTIAL_CODING_AGENT_SESSION_FILE=

# The chat connector (src/taktus/adapters/driven/connectors/slack/): the FILES that hold the bot
# token of Taktus's app in the owner's chat workspace, which it posts and reads with, and the
# app's signing secret, which every event delivery is verified with (NEED-0018). Read by the
# connector at each call and each delivery; paths only, readable by the owner alone. The channel
# itself is added to an instance by TAKTUS_CONNECTORS below: channel.chat=<its MCP address>.
TAKTUS_CREDENTIAL_CHAT_TOKEN_FILE=
TAKTUS_CREDENTIAL_CHAT_SIGNING_SECRET_FILE=

# Telemetry: spans for every run, step, worker call and connector call are always real, and
# their trace identifier is on every ledger entry and every log line. They are exported only
# when an OTLP endpoint is named here (protocol grpc, the default, or http); headers the
# endpoint needs — an authorisation token goes here — are a secret and come from a file.
# Absent: exported nowhere, and nothing fails.
TAKTUS_OTLP_ENDPOINT=
TAKTUS_OTLP_PROTOCOL=
TAKTUS_OTLP_HEADERS_FILE=
TAKTUS_OTLP_SERVICE_NAME=

# The capacity report and admission against the platform (docs/architecture/platform.md).
# Storage: below the warning share of a volume free (default 10 %) a person must act, and is told
# that many days (default 30) before the growth takes it there; below the refusal share (default
# 2 %, and below the warning share) a run is refused. Memory and CPU: below their warning shares
# (default 10 % each) a person must act; a job's memory limit plus the reserve (default 256 MB)
# must be free for it to start. Runs per day are counted over a window (default 14 days). The
# database's volume is not visible from the instance: its size in MB, unset = not observed.
# Whether the state's volumes can be expanded in place: true, false, unset = not known. The
# daemon's scheduler reports every interval (default 3600 s); `uv run taktusctl capacity` on
# demand.
TAKTUS_CAPACITY_STORAGE_WARN_PERCENT=
TAKTUS_CAPACITY_STORAGE_REFUSE_PERCENT=
TAKTUS_CAPACITY_ACT_WITHIN_DAYS=
TAKTUS_CAPACITY_MEMORY_WARN_PERCENT=
TAKTUS_CAPACITY_CPU_WARN_PERCENT=
TAKTUS_CAPACITY_MEMORY_RESERVE_MB=
TAKTUS_CAPACITY_WINDOW_DAYS=
TAKTUS_CAPACITY_DATABASE_VOLUME_MB=
TAKTUS_CAPACITY_STORAGE_EXPANDABLE=
TAKTUS_CAPACITY_INTERVAL_SECONDS=

# Where artifact bytes are written, and — without a database — the snapshot of the state
# (default ~/.cache/taktus/taktusctl).
TAKTUS_STATE_DIR=

# The tenant `taktusctl run` acts for (default `default`, created by the first migration).
TAKTUS_TENANT=

# The identity `taktusctl run` and `submit` act for when --identity is not given: one the
# tenant knows (`taktusctl identity add idn_owner`), never a new one (ADR-0040). The daemon does
# not read it: a webhook sender is placed by the link of their account, nothing else.
TAKTUS_IDENTITY=

# The host port of the development database (default 5432; `make db-up`). Change it when
# 5432 is taken, and the port in TAKTUS_DATABASE_URL with it.
TAKTUS_DB_PORT=

# --- The conformance suite the instance runs itself (ADR-0044) -----------------------------
# `taktusctl conformance record <identifier>` and the loopback operation
# orchestrator.conformance.run run an adapter's suite against the endpoint configured above and
# record the outcome in its maturity. For the worker: a JSON file with the task the assignments
# carry, the hosts that task reaches (comma separated), the name of the credential W-08 searches
# for (default TAKTUS_CONFORMANCE_CREDENTIAL; its value is read from
# TAKTUS_CREDENTIAL_<NAME>_FILE, as every credential is), and the worker's log, if the instance
# can read it.
TAKTUS_CONFORMANCE_WORKER_TASK=
TAKTUS_CONFORMANCE_WORKER_HOSTS=
TAKTUS_CONFORMANCE_WORKER_CREDENTIAL=
TAKTUS_CONFORMANCE_WORKER_LOG=
# For each connector of TAKTUS_CONNECTORS, the scenario its suite runs — it writes into the
# target the scenario names, so point it at a sandbox, never at a target a process works on — and
# the connector's log, if the instance can read it. The label in capitals, dots as underscores:
# channel.repo is TAKTUS_CONFORMANCE_CONNECTOR_CHANNEL_REPO_SCENARIO. The credential values its
# scenario names are read from TAKTUS_CREDENTIAL_<NAME>_FILE.
# TAKTUS_CONFORMANCE_CONNECTOR_<LABEL>_SCENARIO=
# TAKTUS_CONFORMANCE_CONNECTOR_<LABEL>_LOG=
# Seconds one assignment or one call may take, and seconds between two events of a worker's
# stream; the suite's own defaults where unset.
TAKTUS_CONFORMANCE_TIMEOUT=
TAKTUS_CONFORMANCE_IDLE_TIMEOUT=

# --- taktusd, the daemon (deploy/docker/compose.yml sets these for the container) ---------

# The roles this process runs: a comma-separated subset of api, runner, scheduler, automation,
# or `all` (default) — every role in one process, the self-hosting shape.
TAKTUS_ROLES=

# Bring the database to the current schema before serving (default false). Off, the daemon
# refuses to start against a schema that is not at the revision it was built for.
TAKTUS_MIGRATE_ON_START=

# Where the HTTP surface listens (default 127.0.0.1:8080) and the path prefix everything is
# served under (default /), for a platform that places the instance under a sub-path.
TAKTUS_HTTP_HOST=
TAKTUS_HTTP_PORT=
TAKTUS_PATH_PREFIX=

# Channel capability → the MCP URL of the connector that serves its webhook intake, comma
# separated: channel.repo=http://connector:9100/mcp,channel.chat=http://chat-connector:9101/mcp
TAKTUS_CONNECTORS=

# The MCP URL of a connector that serves repository.issues and repository.comments on the
# Taktus repository. Set, the scheduler sends this instance's product findings there: what a
# step met that the product lacks, with the run, the cause and the time waited (UC-6.12). Unset
# (the default), findings are only recorded on the instance; `taktusctl findings` shows them.
TAKTUS_FINDINGS_CONNECTOR=

# The tenants this instance serves (comma separated, default `default`); the runner claims work
# for each in turn, an intake lands in the first.
TAKTUS_TENANTS=

# How this process names its claims; unique among instances on one database (default: host
# name and pid).
TAKTUS_INSTANCE=

# Seconds a running step may take to reach its boundary after SIGTERM (default 300), how long a
# claim stays with a runner that stopped renewing it (default 60), how often an idle role looks
# again (default 1.0), how many runs one runner executes at a time (default 4).
TAKTUS_SHUTDOWN_CEILING_SECONDS=
TAKTUS_LEASE_SECONDS=
TAKTUS_POLL_SECONDS=
TAKTUS_RUNNER_CONCURRENCY=

# debug, info (default), warning, error. One JSON object per line on stderr; never a secret.
TAKTUS_LOG_LEVEL=
