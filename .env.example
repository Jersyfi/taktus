# The environment of one Taktus instance. Names only: copy this file to .env (ignored by git)
# and fill in the values there. No value is ever committed to this repository (CLAUDE.md §9).
# The composition root reads these through the configuration port; an empty variable counts as
# not configured.

# Where the state lives. Unset: the in-memory implementation with a file snapshot under
# TAKTUS_STATE_DIR — development only, not durable. Set: PostgreSQL, migrated with `make
# migrate`. The URL may carry a password; it is a secret and is listed in CREDENTIALS.md.
# With the development database of deploy/docker/compose.dev.yml (no password, trusts local
# connections): postgresql://taktus@127.0.0.1:5432/taktus
TAKTUS_DATABASE_URL=

# The worker endpoint `taktusctl run` sends worker steps to (default http://127.0.0.1:9000).
TAKTUS_WORKER=

# Where artifact bytes are written, and — without a database — the snapshot of the state
# (default ~/.cache/taktus/taktusctl).
TAKTUS_STATE_DIR=

# The tenant `taktusctl run` acts for (default `default`, created by the first migration).
TAKTUS_TENANT=

# The host port of the development database (default 5432; `make db-up`). Change it when
# 5432 is taken, and the port in TAKTUS_DATABASE_URL with it.
TAKTUS_DB_PORT=
