# Architecture contracts. See docs/architecture/project-structure.md §3 and ADR-0003.
# There is no compiler enforcing these boundaries, so these contracts are the architecture.

[importlinter]
root_packages =
    taktus
include_external_packages = True

[importlinter:contract:layers]
name = Dependencies point inward
type = layers
layers =
    taktus.composition
    taktus.adapters
    taktus.components
    taktus.ports
    taktus.shared
    taktus.wire

[importlinter:contract:components-independent]
name = Components never import each other
type = independence
modules =
    taktus.components.identity
    taktus.components.command
    taktus.components.process
    taktus.components.run
    taktus.components.governance
    taktus.components.decision
    taktus.components.catalog
    taktus.components.accounting
    taktus.components.knowledge
    taktus.components.value
    taktus.components.ledger

[importlinter:contract:core-is-technology-free]
name = The core imports no technology
type = forbidden
source_modules =
    taktus.components
    taktus.ports
    taktus.shared
forbidden_modules =
    httpx
    sqlalchemy
    psycopg
    fastapi
    uvicorn
    alembic
    mcp

[importlinter:contract:conformance-stands-alone]
name = The conformance suite imports nothing from the control plane
type = forbidden
source_modules =
    taktus.conformance
forbidden_modules =
    taktus.components
    taktus.ports
    taktus.adapters
    taktus.composition
    taktus.shared

[importlinter:contract:driven-adapters-see-only-ports]
name = Driven adapters never import a component
type = forbidden
source_modules =
    taktus.adapters.driven
forbidden_modules =
    taktus.components
    taktus.composition
    taktus.conformance
    taktus.adapters.driving

[importlinter:contract:driving-adapters-are-wired-not-wiring]
name = Driving adapters never build their own dependencies
type = forbidden
source_modules =
    taktus.adapters.driving
forbidden_modules =
    taktus.adapters.driven
    taktus.composition

[importlinter:contract:wire-stands-alone]
name = Wire formats stand alone
type = forbidden
source_modules =
    taktus.wire
forbidden_modules =
    taktus.components
    taktus.ports
    taktus.adapters
    taktus.composition
    taktus.conformance
    taktus.shared
    httpx
    pydantic
