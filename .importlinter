# Architecture contracts. See docs/architecture/project-structure.md §3 and ADR-0003.
# There is no compiler enforcing these boundaries, so these contracts are the architecture.

[importlinter]
root_packages =
    taktus
include_external_packages = True

[importlinter:contract:layers]
name = Dependencies point inward
type = layers
layers =
    taktus.composition
    taktus.adapters
    taktus.components
    taktus.ports
    taktus.shared

[importlinter:contract:components-independent]
name = Components never import each other
type = independence
modules =
    taktus.components.identity
    taktus.components.command
    taktus.components.process
    taktus.components.run
    taktus.components.governance
    taktus.components.decision
    taktus.components.catalog
    taktus.components.accounting
    taktus.components.knowledge
    taktus.components.value
    taktus.components.ledger

[importlinter:contract:core-is-technology-free]
name = The core imports no technology
type = forbidden
source_modules =
    taktus.components
    taktus.ports
    taktus.shared
forbidden_modules =
    httpx
    sqlalchemy
    psycopg
    fastapi
    uvicorn
    alembic
    mcp

[importlinter:contract:conformance-stands-alone]
name = The conformance suite imports nothing from the control plane
type = forbidden
source_modules =
    taktus.conformance
forbidden_modules =
    taktus.components
    taktus.ports
    taktus.adapters
    taktus.composition
    taktus.shared
