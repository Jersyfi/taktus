{
  "credentials": {
    "actions": "WORKLOADS_TOKEN"
  },
  "read": {
    "operation": "deployment.workloads.read",
    "input": {
      "name": "web"
    }
  },
  "writes": [
    {
      "operation": "deployment.workloads.release",
      "input": {
        "name": "web",
        "container": "app",
        "image": "registry.example/app:conformance-{{unique}}"
      }
    },
    {
      "operation": "deployment.workloads.throttle",
      "input": {
        "name": "web",
        "max_instances": 3
      }
    }
  ],
  "invalid": {
    "operation": "deployment.workloads.read",
    "input": {
      "name": "Not A Name"
    },
    "expected_cause": "invalid"
  }
}
