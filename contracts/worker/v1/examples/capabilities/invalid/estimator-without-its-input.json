{
  "contract": "worker/v1",
  "capabilities": [
    "shell.script",
    "shell.sandboxed",
    "workspace.isolated"
  ],
  "consumption": {
    "kinds": [
      "compute"
    ],
    "resource_classes": [
      "cpu.small"
    ]
  },
  "supports": {
    "native_pause": false,
    "step_boundary_signal": true,
    "streaming_events": true,
    "estimate": true
  },
  "max_concurrent_assignments": 8,
  "estimator": {
    "kind": "per_item",
    "each": {
      "confidence": "low",
      "compute_seconds": 0.3,
      "resource_class": "cpu.small",
      "wall_seconds": 1,
      "steps": 1
    },
    "otherwise": {
      "confidence": "low",
      "compute_seconds": 1.2,
      "resource_class": "cpu.small",
      "wall_seconds": 2,
      "steps": 4
    }
  }
}
