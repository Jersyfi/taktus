{
  "contract": "worker/v1",
  "capabilities": [
    "code.edit",
    "code.test",
    "vcs.branch",
    "vcs.pullrequest",
    "workspace.isolated",
    "shell.sandboxed"
  ],
  "consumption": {
    "kinds": [
      "quota",
      "currency"
    ],
    "window_seconds": 18000,
    "unit": "session-units",
    "currencies": [
      "eur"
    ]
  },
  "supports": {
    "native_pause": false,
    "step_boundary_signal": true,
    "streaming_events": true,
    "estimate": true
  },
  "max_concurrent_assignments": 2
}
