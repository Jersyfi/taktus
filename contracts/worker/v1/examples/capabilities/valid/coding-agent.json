{
  "contract": "worker/v1",
  "version": "2.3.0",
  "capabilities": [
    "code.edit",
    "code.test",
    "vcs.branch",
    "vcs.pullrequest",
    "workspace.isolated",
    "shell.sandboxed"
  ],
  "consumption": {
    "kinds": [
      "quota",
      "currency"
    ],
    "window_seconds": 18000,
    "unit": "session-units",
    "currencies": [
      "eur"
    ]
  },
  "supports": {
    "native_pause": false,
    "step_boundary_signal": true,
    "streaming_events": true,
    "estimate": true
  },
  "max_concurrent_assignments": 2,
  "estimator": {
    "kind": "fixed",
    "estimate": {
      "confidence": "low",
      "tokens_in": 400000,
      "tokens_out": 40000,
      "currency": {
        "eur": 4.0
      },
      "quota_units": 20,
      "wall_seconds": 1800,
      "steps": 20
    }
  }
}
