{
  "contract": "worker/v1",
  "capabilities": [
    "ml.train",
    "ml.evaluate",
    "ml.embed",
    "data.read",
    "workspace.isolated"
  ],
  "consumption": {
    "kinds": [
      "compute"
    ],
    "resource_classes": [
      "cpu.large",
      "gpu.small",
      "gpu.large"
    ]
  },
  "supports": {
    "native_pause": true,
    "step_boundary_signal": true,
    "streaming_events": true,
    "estimate": true
  },
  "max_concurrent_assignments": 1
}
