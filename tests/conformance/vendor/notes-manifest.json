{
  "contract": "connector/v1",
  "capabilities": [
    "notes.pages"
  ],
  "credential": "VENDOR_TOKEN",
  "operations": [
    {
      "tool": "list_notes",
      "name": "notes.pages.list",
      "capability": "notes.pages",
      "effect": "read",
      "demand": {
        "quota_units": 2
      }
    },
    {
      "tool": "get_note",
      "name": "notes.pages.get",
      "capability": "notes.pages",
      "effect": "read",
      "demand": {
        "quota_units": 2
      }
    },
    {
      "tool": "create_note",
      "name": "notes.pages.create",
      "capability": "notes.pages",
      "effect": "write",
      "idempotency": "native",
      "key_argument": "request_id",
      "replayed": "/replayed",
      "record": {
        "kind": "note",
        "id": "/id",
        "url": "/url"
      },
      "demand": {
        "quota_units": 2
      },
      "summary": "Create a note. The vendor's tool recognises a repeated request_id itself."
    },
    {
      "tool": "archive_note",
      "name": "notes.pages.archive",
      "capability": "notes.pages",
      "effect": "write",
      "idempotency": "none",
      "record": {
        "kind": "note",
        "id": "/id"
      },
      "demand": {
        "quota_units": 2
      }
    }
  ]
}
