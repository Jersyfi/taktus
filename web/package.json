{
  "name": "taktus-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/tokens.js",
    "dev": "node scripts/tokens.js && vite dev",
    "build": "node scripts/tokens.js && vite build && node scripts/relative.js",
    "check": "node scripts/tokens.js && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node scripts/tokens.js && svelte-kit sync && vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
